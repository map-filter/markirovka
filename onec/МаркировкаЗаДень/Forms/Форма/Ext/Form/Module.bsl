&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	АдресСервиса = ХранилищеОбщихНастроек.Загрузить("МаркировкаЗаДень", "АдресСервиса");
	Токен = ХранилищеОбщихНастроек.Загрузить("МаркировкаЗаДень", "Токен");
	Если Не ЗначениеЗаполнено(АдресСервиса) Тогда
		АдресСервиса = "http://127.0.0.1:8301";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьЗаказы(Команда)

	Если Не ПроверитьНастройки() Тогда
		Возврат;
	КонецЕсли;
	ЗагрузитьЗаказыНаСервере();
	Состояние(СтрШаблон("Загружено заказов: %1", Заказы.Количество()));

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьКоды(Команда)

	Если Не ПроверитьНастройки() Тогда
		Возврат;
	КонецЕсли;
	ТекущийЗаказ = Элементы.Заказы.ТекущиеДанные;
	Если ТекущийЗаказ <> Неопределено И Не ЗначениеЗаполнено(НомерЗаказа) Тогда
		НомерЗаказа = ТекущийЗаказ.Номер;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(НомерЗаказа) И Не ЗначениеЗаполнено(GTIN) Тогда
		ПоказатьПредупреждение(, "Выберите заказ или укажите GTIN");
		Возврат;
	КонецЕсли;
	ПолучитьКодыНаСервере();
	Состояние(СтрШаблон("Получено кодов: %1", Коды.Количество()));

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСтатусы(Команда)

	Если Не ПроверитьНастройки() Или Коды.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	НеНайдены = ОбновитьСтатусыНаСервере();
	Если НеНайдены > 0 Тогда
		ПоказатьПредупреждение(, СтрШаблон("Не найдено в сервисе кодов: %1", НеНайдены));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьВДокумент(Команда)

	Если Не ЗначениеЗаполнено(Документ) Тогда
		ПоказатьПредупреждение(, "Выберите документ 1С, в который нужно записать коды");
		Возврат;
	КонецЕсли;
	Добавлено = ЗаписатьВДокументНаСервере();
	ПоказатьОповещениеПользователя("Коды записаны", ПолучитьНавигационнуюСсылку(Документ), СтрШаблон("Добавлено строк: %1", Добавлено));

КонецПроцедуры

&НаКлиенте
Процедура СохранитьВФайл(Команда)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Фильтр = "Текст (*.txt)|*.txt";
	Диалог.ПолноеИмяФайла = "kody-" + СтрЗаменить(НомерЗаказа, "З-", "") + ".txt";
	Диалог.Показать(Новый ОписаниеОповещения("СохранитьВФайлЗавершение", ЭтотОбъект));

КонецПроцедуры

&НаКлиенте
Процедура СохранитьВФайлЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Текст = Новый ТекстовыйДокумент;
	Для Каждого Строка Из Коды Цикл
		Текст.ДобавитьСтроку(Строка.Код);
	КонецЦикла;
	Текст.НачатьЗапись(, ВыбранныеФайлы[0], КодировкаТекста.UTF8, Символы.ПС);

КонецПроцедуры

&НаКлиенте
Процедура АдресСервисаПриИзменении(Элемент)

	СохранитьНастройки();

КонецПроцедуры

&НаКлиенте
Процедура ТокенПриИзменении(Элемент)

	СохранитьНастройки();

КонецПроцедуры

&НаКлиенте
Процедура ЗаказыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	НомерЗаказа = Элементы.Заказы.ТекущиеДанные.Номер;
	ПолучитьКоды(Неопределено);

КонецПроцедуры

&НаКлиенте
Функция ПроверитьНастройки()

	Если Не ЗначениеЗаполнено(АдресСервиса) Или Не ЗначениеЗаполнено(Токен) Тогда
		ПоказатьПредупреждение(, "Укажите адрес сервиса и токен интеграции (кабинет: Настройки, Токен для 1С)");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;

КонецФункции

&НаСервере
Процедура СохранитьНастройки()

	ХранилищеОбщихНастроек.Сохранить("МаркировкаЗаДень", "АдресСервиса", АдресСервиса);
	ХранилищеОбщихНастроек.Сохранить("МаркировкаЗаДень", "Токен", Токен);

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьЗаказыНаСервере()

	Заказы.Очистить();
	Для Каждого Заказ Из РеквизитФормыВЗначение("Объект").ЗаказыКодов(АдресСервиса, Токен) Цикл
		Строка = Заказы.Добавить();
		Строка.Номер = Заказ.number;
		Строка.GTIN = Заказ.gtin;
		Строка.Товар = Заказ.product;
		Строка.Количество = Заказ.quantity;
		Строка.Статус = Заказ.status;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПолучитьКодыНаСервере()

	Коды.Очистить();
	Для Каждого Код Из РеквизитФормыВЗначение("Объект").КодыПоЗаказу(АдресСервиса, Токен, НомерЗаказа, GTIN) Цикл
		ЗаполнитьЗначенияСвойств(Коды.Добавить(), Код);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ОбновитьСтатусыНаСервере()

	СписокКодов = Новый Массив;
	Для Каждого Строка Из Коды Цикл
		СписокКодов.Добавить(Строка.Код);
	КонецЦикла;
	Результат = РеквизитФормыВЗначение("Объект").СтатусыКодов(АдресСервиса, Токен, СписокКодов);
	ПоКоду = Новый Соответствие;
	Для Каждого Код Из Результат.Коды Цикл
		ПоКоду.Вставить(Код.Код, Код);
	КонецЦикла;
	Для Каждого Строка Из Коды Цикл
		Код = ПоКоду.Получить(Строка.Код);
		Если Код <> Неопределено Тогда
			Строка.Статус = Код.Статус;
			Строка.СтатусПредставление = Код.СтатусПредставление;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат.НеНайдены.Количество();

КонецФункции

&НаСервере
Функция ЗаписатьВДокументНаСервере()

	Массив = Новый Массив;
	Для Каждого Строка Из Коды Цикл
		Структура = Новый Структура("Код, КодЧитаемый, GTIN, Серийный, Статус, СтатусПредставление, Товар, Заказ");
		ЗаполнитьЗначенияСвойств(Структура, Строка);
		Массив.Добавить(Структура);
	КонецЦикла;
	Возврат РеквизитФормыВЗначение("Объект").ЗаписатьКодыВДокумент(Документ, Массив, Номенклатура);

КонецФункции
