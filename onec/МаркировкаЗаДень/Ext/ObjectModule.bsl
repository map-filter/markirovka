// Возвращает сведения о внешней обработке для подключения через справочник «Дополнительные отчеты и обработки».
//
// Возвращаемое значение:
//   Структура
//
Функция СведенияОВнешнейОбработке() Экспорт

	Сведения = Новый Структура;
	Сведения.Вставить("Вид", "ДополнительнаяОбработка");
	Сведения.Вставить("Наименование", "Маркировка за день: коды маркировки");
	Сведения.Вставить("Версия", "0.1");
	Сведения.Вставить("БезопасныйРежим", Ложь);
	Сведения.Вставить("Информация", "Загрузка кодов Data Matrix и их статусов из сервиса «Маркировка за день»");
	Сведения.Вставить("Команды", Новый ТаблицаЗначений);
	Сведения.Команды.Колонки.Добавить("Представление");
	Сведения.Команды.Колонки.Добавить("Идентификатор");
	Сведения.Команды.Колонки.Добавить("Использование");
	Сведения.Команды.Колонки.Добавить("ПоказыватьОповещение");
	Сведения.Команды.Колонки.Добавить("Модификатор");
	Команда = Сведения.Команды.Добавить();
	Команда.Представление = "Коды маркировки из сервиса";
	Команда.Идентификатор = "ОткрытьФорму";
	Команда.Использование = "ОткрытиеФормы";
	Возврат Сведения;

КонецФункции

// Загружает список заказов кодов.
//
// Параметры:
//   АдресСервиса - Строка - например, https://markirovka.example.kz
//   Токен - Строка - токен интеграции из настроек кабинета
//
// Возвращаемое значение:
//   Массив из Структура - number, gtin, product, quantity, status, created_at
//
Функция ЗаказыКодов(АдресСервиса, Токен) Экспорт

	Ответ = ВыполнитьЗапрос(АдресСервиса, Токен, "GET", "/api/integration/v1/orders");
	Возврат Ответ.orders;

КонецФункции

// Загружает коды по номеру заказа или GTIN.
//
// Параметры:
//   АдресСервиса - Строка
//   Токен - Строка
//   НомерЗаказа - Строка - например, З-000001
//   GTIN - Строка
//
// Возвращаемое значение:
//   Массив из Структура - Код (с символом GS), КодЧитаемый, GTIN, Серийный, Статус, СтатусПредставление, Товар, Заказ
//
Функция КодыПоЗаказу(АдресСервиса, Токен, НомерЗаказа = "", GTIN = "") Экспорт

	Параметры = Новый Массив;
	Параметры.Добавить("format=json");
	Если ЗначениеЗаполнено(НомерЗаказа) Тогда
		Параметры.Добавить("order=" + КодироватьСтроку(НомерЗаказа, СпособКодированияСтроки.КодировкаURL));
	КонецЕсли;
	Если ЗначениеЗаполнено(GTIN) Тогда
		Параметры.Добавить("gtin=" + GTIN);
	КонецЕсли;
	Ответ = ВыполнитьЗапрос(АдресСервиса, Токен, "GET", "/api/integration/v1/codes?" + СтрСоединить(Параметры, "&"));
	Возврат ПреобразоватьКоды(Ответ.codes);

КонецФункции

// Запрашивает текущие статусы кодов.
//
// Параметры:
//   АдресСервиса - Строка
//   Токен - Строка
//   Коды - Массив из Строка - коды целиком или в виде (01)..(21)..
//
// Возвращаемое значение:
//   Структура - Коды (Массив из Структура), НеНайдены (Массив из Строка)
//
Функция СтатусыКодов(АдресСервиса, Токен, Коды) Экспорт

	Тело = Новый Структура("codes", Коды);
	Ответ = ВыполнитьЗапрос(АдресСервиса, Токен, "POST", "/api/integration/v1/codes/statuses", Тело);
	Результат = Новый Структура;
	Результат.Вставить("Коды", ПреобразоватьКоды(Ответ.codes));
	Результат.Вставить("НеНайдены", Ответ.not_found);
	Возврат Результат;

КонецФункции

// Записывает коды в табличную часть документа, если у документа есть подходящая табличная часть.
// Ищется табличная часть «КодыМаркировки» (или «ШтрихкодыУпаковок») с реквизитом «КодМаркировки»
// (или «ЗначениеШтрихкода»); при наличии заполняются реквизиты «Статус» и «Номенклатура».
//
// Параметры:
//   Документ - ДокументСсылка
//   Коды - Массив из Структура - результат КодыПоЗаказу
//   Номенклатура - СправочникСсылка.Номенклатура, Неопределено
//
// Возвращаемое значение:
//   Число - сколько строк добавлено
//
Функция ЗаписатьКодыВДокумент(Документ, Коды, Номенклатура = Неопределено) Экспорт

	МетаданныеДокумента = Документ.Метаданные();
	ИмяТЧ = НайтиИмя(МетаданныеДокумента.ТабличныеЧасти, "КодыМаркировки,ШтрихкодыУпаковок");
	Если ИмяТЧ = Неопределено Тогда
		ВызватьИсключение СтрШаблон("В документе «%1» нет табличной части для кодов маркировки. Выгрузите коды в файл и загрузите типовой командой.", МетаданныеДокумента.Синоним);
	КонецЕсли;
	РеквизитыТЧ = МетаданныеДокумента.ТабличныеЧасти[ИмяТЧ].Реквизиты;
	ИмяКода = НайтиИмя(РеквизитыТЧ, "КодМаркировки,ЗначениеШтрихкода,Код");
	Если ИмяКода = Неопределено Тогда
		ВызватьИсключение "В табличной части нет реквизита для кода маркировки";
	КонецЕсли;
	ИмяСтатуса = НайтиИмя(РеквизитыТЧ, "Статус,СтатусКодаМаркировки");
	ИмяНоменклатуры = НайтиИмя(РеквизитыТЧ, "Номенклатура");

	Объект = Документ.ПолучитьОбъект();
	Таблица = Объект[ИмяТЧ];
	Существующие = Новый Соответствие;
	Для Каждого Строка Из Таблица Цикл
		Существующие.Вставить(Строка[ИмяКода], Строка);
	КонецЦикла;

	Добавлено = 0;
	Для Каждого Код Из Коды Цикл
		Строка = Существующие.Получить(Код.Код);
		Если Строка = Неопределено Тогда
			Строка = Таблица.Добавить();
			Строка[ИмяКода] = Код.Код;
			Добавлено = Добавлено + 1;
		КонецЕсли;
		Если ИмяСтатуса <> Неопределено Тогда
			Строка[ИмяСтатуса] = Код.СтатусПредставление;
		КонецЕсли;
		Если ИмяНоменклатуры <> Неопределено И ЗначениеЗаполнено(Номенклатура) Тогда
			Строка[ИмяНоменклатуры] = Номенклатура;
		КонецЕсли;
	КонецЦикла;

	Объект.Записать(РежимЗаписиДокумента.Запись);
	Возврат Добавлено;

КонецФункции

// Сохраняет коды в текстовый файл: по одному коду в строке, символ GS сохраняется.
//
// Параметры:
//   ИмяФайла - Строка
//   Коды - Массив из Структура
//
Процедура СохранитьКодыВФайл(ИмяФайла, Коды) Экспорт

	Запись = Новый ЗаписьТекста(ИмяФайла, КодировкаТекста.UTF8, Символы.ПС);
	Для Каждого Код Из Коды Цикл
		Запись.ЗаписатьСтроку(Код.Код);
	КонецЦикла;
	Запись.Закрыть();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьЗапрос(АдресСервиса, Токен, Метод, Путь, Тело = Неопределено)

	Адрес = РазобратьАдрес(АдресСервиса);
	Защищенное = ?(Адрес.Схема = "https", Новый ЗащищенноеСоединениеOpenSSL(, Новый СертификатыУдостоверяющихЦентровОС), Неопределено);
	Соединение = Новый HTTPСоединение(Адрес.Хост, Адрес.Порт, , , , 60, Защищенное);

	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", "Bearer " + СокрЛП(Токен));
	Заголовки.Вставить("Accept", "application/json");
	Если Тело <> Неопределено Тогда
		Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	КонецЕсли;
	Запрос = Новый HTTPЗапрос(Адрес.Путь + Путь, Заголовки);
	Если Тело <> Неопределено Тогда
		Запрос.УстановитьТелоИзСтроки(ЗаписатьВJSON(Тело), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;

	Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
	Текст = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если Ответ.КодСостояния = 401 Тогда
		ВызватьИсключение "Сервис не принял токен интеграции: выпустите новый в настройках кабинета";
	ИначеЕсли Ответ.КодСостояния >= 300 Тогда
		ВызватьИсключение СтрШаблон("Сервис ответил кодом %1: %2", Ответ.КодСостояния, Лев(Текст, 500));
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Ложь);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

Функция ПреобразоватьКоды(МассивИзСервиса)

	Результат = Новый Массив;
	Если МассивИзСервиса = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Элемент Из МассивИзСервиса Цикл
		Код = Новый Структура;
		Код.Вставить("Код", ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(Элемент.code_base64), КодировкаТекста.UTF8));
		Код.Вставить("КодЧитаемый", Элемент.code_hr);
		Код.Вставить("GTIN", Элемент.gtin);
		Код.Вставить("Серийный", Элемент.serial);
		Код.Вставить("Статус", Элемент.status);
		Код.Вставить("СтатусПредставление", Элемент.status_label);
		Код.Вставить("Товар", Элемент.product);
		Код.Вставить("Заказ", Элемент.order);
		Результат.Добавить(Код);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция РазобратьАдрес(Знач АдресСервиса)

	АдресСервиса = СокрЛП(АдресСервиса);
	Результат = Новый Структура("Схема, Хост, Порт, Путь", "https", "", 0, "");
	Позиция = СтрНайти(АдресСервиса, "://");
	Если Позиция > 0 Тогда
		Результат.Схема = НРег(Лев(АдресСервиса, Позиция - 1));
		АдресСервиса = Сред(АдресСервиса, Позиция + 3);
	КонецЕсли;
	Позиция = СтрНайти(АдресСервиса, "/");
	Если Позиция > 0 Тогда
		Результат.Путь = Сред(АдресСервиса, Позиция);
		АдресСервиса = Лев(АдресСервиса, Позиция - 1);
	КонецЕсли;
	Если Прав(Результат.Путь, 1) = "/" Тогда
		Результат.Путь = Лев(Результат.Путь, СтрДлина(Результат.Путь) - 1);
	КонецЕсли;
	Позиция = СтрНайти(АдресСервиса, ":");
	Если Позиция > 0 Тогда
		Результат.Порт = Число(Сред(АдресСервиса, Позиция + 1));
		АдресСервиса = Лев(АдресСервиса, Позиция - 1);
	Иначе
		Результат.Порт = ?(Результат.Схема = "https", 443, 80);
	КонецЕсли;
	Результат.Хост = АдресСервиса;
	Возврат Результат;

КонецФункции

Функция ЗаписатьВJSON(Значение)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();

КонецФункции

Функция НайтиИмя(КоллекцияМетаданных, ВариантыСтрокой)

	Для Каждого Вариант Из СтрРазделить(ВариантыСтрокой, ",") Цикл
		Если КоллекцияМетаданных.Найти(Вариант) <> Неопределено Тогда
			Возврат Вариант;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

